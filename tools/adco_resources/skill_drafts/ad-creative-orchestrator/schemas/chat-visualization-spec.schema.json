{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/adco/chat-visualization-spec.schema.json",
  "title": "ADCO Chat Visualization Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "view_id",
    "execution_context",
    "controller",
    "phase",
    "surface",
    "source_truth",
    "presentation",
    "interactions",
    "write_boundary",
    "fallback"
  ],
  "properties": {
    "contract": {"const": "adco.chat-visualization@1.0"},
    "view_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "execution_context": {"enum": ["standalone_chat", "orchestrated_provider"]},
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface_owner", "user_facing"],
      "properties": {
        "surface_owner": {"const": "ad-creative-orchestrator"},
        "user_facing": {"type": "boolean"}
      }
    },
    "phase": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"]},
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "summary", "question"],
      "properties": {
        "kind": {
          "enum": [
            "current-status",
            "phase-logic",
            "blocking-decision",
            "option-comparison",
            "asset-review",
            "ppt-slide-review",
            "feedback-impact"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1}
      }
    },
    "source_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "current_version", "artifacts"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "current_version": {"type": "string", "minLength": 1},
        "binding_mode": {"enum": ["fixture-placeholder", "adco-control-plane"]},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "options", "recommendation", "downstream_effects"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/field"}
        },
        "options": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/option"}
        },
        "recommendation": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["option_id", "reason"],
              "properties": {
                "option_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "downstream_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase", "effect"],
            "properties": {
              "phase": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8"]},
              "effect": {"type": "string", "minLength": 1}
            }
          }
        },
        "quantitative_evidence": {
          "description": "Optional reviewed numeric evidence; it never replaces the OpenAI Visualizations interaction or writeback contract.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "unit", "source_ref"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "value": {"type": "number"},
              "unit": {"type": "string"},
              "source_ref": {"type": "string"}
            }
          }
        },
        "previews": {
          "description": "Optional inspected image or slide previews. The renderer embeds bytes only after project-root and SHA-256 verification.",
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "#/$defs/preview"}
        },
        "creative_review": {
          "description": "ADCO-specific advertising role, creative reading and channel placement for one reviewed visual.",
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/creativeReview"}
          ]
        }
      }
    },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_state", "actions"],
      "properties": {
        "local_state": {
          "type": "array",
          "items": {"enum": ["selected-option", "expanded-detail", "draft-feedback", "focused-item"]}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    },
    "write_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_writes_authoritative_state",
        "conversation_intent_only",
        "write_owner",
        "revalidation_command",
        "forbidden_claims"
      ],
      "properties": {
        "component_writes_authoritative_state": {"const": false},
        "conversation_intent_only": {"const": true},
        "write_owner": {"const": "ad-creative-orchestrator"},
        "revalidation_command": {"const": "adco validate <project>"},
        "forbidden_claims": {
          "type": "array",
          "allOf": [
            {"contains": {"const": "approval"}},
            {"contains": {"const": "readiness"}},
            {"contains": {"const": "send"}},
            {"contains": {"const": "completion"}},
            {"contains": {"const": "global-install"}}
          ],
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["approval", "readiness", "send", "completion", "global-install"]}
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "table", "mermaid", "decision_prompt"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headers", "rows"],
          "properties": {
            "headers": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "array", "minItems": 2, "items": {"type": ["string", "number", "boolean"]}}
            }
          }
        },
        "mermaid": {"type": "string", "minLength": 1},
        "decision_prompt": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_context": {"const": "standalone_chat"},
          "controller": {"properties": {"user_facing": {"const": true}}},
          "surface": {"properties": {"kind": {"const": "asset-review"}}}
        }
      },
      "then": {
        "properties": {
          "source_truth": {
            "required": ["binding_mode"],
            "properties": {
              "artifacts": {
                "contains": {
                  "required": ["review_classification", "source_status", "authorization_status", "channel_fit_status", "source_evidence_ref", "authorization_evidence_ref", "channel_fit_evidence_ref"]
                },
                "minContains": 1
              }
            }
          },
          "presentation": {
            "required": ["creative_review"],
            "properties": {
              "previews": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "annotations": {
                      "items": {"required": ["kind", "scope", "basis"]}
                    }
                  }
                }
              },
              "fields": {
                "allOf": [
                  {"contains": {"properties": {"id": {"const": "asset-status"}}, "required": ["id"]}},
                  {"contains": {"properties": {"id": {"const": "source-status"}}, "required": ["id"]}},
                  {"contains": {"properties": {"id": {"const": "authorization-status"}}, "required": ["id"]}},
                  {"contains": {"properties": {"id": {"const": "channel-fit"}}, "required": ["id"]}},
                  {"contains": {"properties": {"id": {"const": "availability"}}, "required": ["id"]}}
                ]
              }
            }
          },
          "interactions": {
            "properties": {
              "actions": {
                "items": {"required": ["review_scope", "review_focus"]}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "version", "sha256", "lifecycle"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "lifecycle": {"enum": ["current", "candidate", "superseded", "stale", "archived", "rejected", "pending"]},
        "review_classification": {"enum": ["real-candidate", "illustrative-placeholder"]},
        "source_status": {"enum": ["verified", "pending", "not-applicable"]},
        "authorization_status": {"enum": ["confirmed", "pending", "not-applicable"]},
        "channel_fit_status": {"enum": ["verified", "pending", "not-applicable"]},
        "source_evidence_ref": {"type": ["string", "null"]},
        "authorization_evidence_ref": {"type": ["string", "null"]},
        "channel_fit_evidence_ref": {"type": ["string", "null"]}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "provenance", "source_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "value": {},
        "provenance": {"enum": ["source-bound", "presentation-only"]},
        "source_ref": {"type": ["string", "null"]}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "label", "alt", "caption", "annotations"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "alt": {"type": "string", "minLength": 1},
        "caption": {"type": "string", "minLength": 1},
        "annotations": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region", "note"],
            "properties": {
              "region": {"type": "string", "minLength": 1},
              "note": {"type": "string", "minLength": 1},
              "kind": {"enum": ["preserve", "revise", "recheck"]},
              "scope": {"enum": ["composition-principle", "person", "product", "emotion", "packaging", "crop", "usage-readiness"]},
              "basis": {"enum": ["composition-reading", "placeholder-limitation", "real-file-observation"]},
              "anchor": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": {"type": "number", "minimum": 0, "maximum": 100},
                  "y": {"type": "number", "minimum": 0, "maximum": 100}
                }
              }
            }
          }
        }
      }
    },
    "reviewLens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "provenance", "source_ref"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["source-bound", "presentation-only"]},
        "source_ref": {"type": ["string", "null"]}
      }
    },
    "creativeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_role", "reference_boundary", "customer_moment", "product_proof", "brand_memory", "channel_plan"],
      "properties": {
        "asset_role": {"$ref": "#/$defs/reviewLens"},
        "reference_boundary": {"$ref": "#/$defs/reviewLens"},
        "customer_moment": {"$ref": "#/$defs/reviewLens"},
        "product_proof": {"$ref": "#/$defs/reviewLens"},
        "brand_memory": {"$ref": "#/$defs/reviewLens"},
        "channel_plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "format", "status", "assessment_basis", "note", "source_ref"],
            "properties": {
              "channel": {"type": "string", "minLength": 1},
              "format": {"enum": ["16:9", "4:5", "1:1", "9:16"]},
              "status": {"enum": ["verified-fit", "preserve-direction", "reframe", "recheck"]},
              "assessment_basis": {"enum": ["creative-direction-only", "real-candidate-check"]},
              "note": {"type": "string", "minLength": 1},
              "source_ref": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "summary", "tradeoff", "source_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "tradeoff": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "target_gate", "conversation_intent"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["submit-selection", "request-revision", "register-feedback", "request-recheck", "inspect-detail"]},
        "target_gate": {"type": "string", "minLength": 1},
        "conversation_intent": {"type": "string", "minLength": 1},
        "review_scope": {"enum": ["creative-revision", "creative-recheck", "asset-use-selection"]},
        "review_focus": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["asset-role", "reference-boundary", "customer-moment", "product-proof", "brand-memory", "region-findings", "channel-placement", "source-and-authorization"]}
        }
      }
    }
  }
}
