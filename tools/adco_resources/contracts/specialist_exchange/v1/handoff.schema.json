{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adco.specialist-exchange/handoff/1.0",
  "title": "ADCO specialist handoff v1",
  "type": "object",
  "required": [
    "protocol_id",
    "contract_version",
    "message_type",
    "exchange_id",
    "handoff_id",
    "attempt",
    "supersedes_handoff_id",
    "work_id",
    "provider_id",
    "profile_id",
    "descriptor_ref",
    "task",
    "source_truth",
    "execution",
    "scope",
    "authorization",
    "acceptance"
  ],
  "properties": {
    "protocol_id": {"const": "adco.specialist-exchange"},
    "contract_version": {"const": "1.0"},
    "message_type": {"const": "handoff"},
    "exchange_id": {"$ref": "#/$defs/safeToken"},
    "handoff_id": {"$ref": "#/$defs/safeToken"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "supersedes_handoff_id": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/safeToken"}
      ]
    },
    "work_id": {"$ref": "#/$defs/safeToken"},
    "provider_id": {"$ref": "#/$defs/safeToken"},
    "profile_id": {"$ref": "#/$defs/safeToken"},
    "descriptor_ref": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["provider_id", "sha256"],
          "properties": {
            "provider_id": {"$ref": "#/$defs/safeToken"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      ]
    },
    "task": {
      "type": "object",
      "required": ["objective", "required_capabilities", "expected_output_kinds"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeToken"}
        },
        "expected_output_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeToken"}
        }
      },
      "additionalProperties": true
    },
    "source_truth": {
      "type": "object",
      "required": ["artifacts", "locks"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceArtifact"}
        },
        "locks": {"type": "array"}
      },
      "additionalProperties": true
    },
    "execution": {"$ref": "#/$defs/execution"},
    "scope": {"$ref": "#/$defs/scope"},
    "authorization": {
      "type": "object",
      "required": [
        "generation_mode",
        "authorized",
        "authorization_ref",
        "external_upload"
      ],
      "properties": {
        "generation_mode": {"enum": ["prompt_only", "real_media"]},
        "authorized": {"type": "boolean"},
        "authorization_ref": {"type": ["string", "null"]},
        "external_upload": {"const": false}
      },
      "additionalProperties": true
    },
    "acceptance": {
      "type": "object",
      "required": [
        "visibility",
        "provider_recommendation_only",
        "required_receipt_extensions",
        "stop_on"
      ],
      "properties": {
        "visibility": {"const": "internal_only"},
        "provider_recommendation_only": {"const": true},
        "required_receipt_extensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/extensionRef"}
        },
        "stop_on": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["needs_user", "blocked", "failed"]},
          "allOf": [
            {"contains": {"const": "needs_user"}},
            {"contains": {"const": "blocked"}},
            {"contains": {"const": "failed"}}
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {"workspace_mode": {"const": "read_only"}},
            "required": ["workspace_mode"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {"write": {"minItems": 1, "maxItems": 1}}
          }
        }
      },
      "else": {
        "properties": {
          "scope": {
            "properties": {"write": {"minItems": 2}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization": {
            "properties": {"generation_mode": {"const": "prompt_only"}},
            "required": ["generation_mode"]
          }
        },
        "required": ["authorization"]
      },
      "then": {
        "properties": {
          "authorization": {
            "properties": {
              "authorized": {"const": false},
              "authorization_ref": {"type": "null"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "authorization": {
            "properties": {
              "generation_mode": {"const": "real_media"},
              "authorized": {"const": true},
              "authorization_ref": {"$ref": "#/$defs/relativePath"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "safeToken": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nullableToken": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/safeToken"}
      ]
    },
    "extensionRef": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/safeToken"},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "sourceArtifact": {
      "type": "object",
      "required": ["artifact_id", "version", "path", "sha256", "visibility"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/safeToken"},
        "version": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "visibility": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "workspace_mode",
        "lane_id",
        "lane_run_id",
        "thread_id",
        "nested_dispatch_allowed"
      ],
      "properties": {
        "mode": {"enum": ["inline", "codex_thread", "external_handoff"]},
        "workspace_mode": {
          "enum": ["read_only", "isolated_workspace", "worktree"]
        },
        "lane_id": {"$ref": "#/$defs/nullableToken"},
        "lane_run_id": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          ]
        },
        "thread_id": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/threadId"}
          ]
        },
        "nested_dispatch_allowed": {"const": false}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "codex_thread"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "workspace_mode": {"const": "isolated_workspace"},
              "lane_id": {"$ref": "#/$defs/safeToken"},
              "lane_run_id": {
                "type": "string",
                "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "thread_id": {"$ref": "#/$defs/threadId"}
            }
          },
          "else": {
            "properties": {
              "lane_id": {"type": "null"},
              "lane_run_id": {"type": "null"},
              "thread_id": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "threadId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "scope": {
      "type": "object",
      "required": ["read", "write", "receipt_path", "host_baseline", "forbidden"],
      "properties": {
        "read": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "write": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        },
        "receipt_path": {"$ref": "#/$defs/relativePath"},
        "host_baseline": {
          "type": "object",
          "required": ["path", "sha256", "manifest_sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/relativePath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativePath"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
