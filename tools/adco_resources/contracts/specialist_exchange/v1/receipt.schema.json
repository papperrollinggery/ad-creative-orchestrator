{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adco.specialist-exchange/receipt/1.0",
  "title": "ADCO specialist provider receipt v1",
  "type": "object",
  "required": [
    "protocol_id",
    "contract_version",
    "message_type",
    "receipt_id",
    "exchange_id",
    "handoff_id",
    "work_id",
    "provider_id",
    "profile_id",
    "descriptor_sha256",
    "handoff_sha256",
    "outcome",
    "consumed_inputs",
    "output_artifacts",
    "qa",
    "open_questions",
    "specialist_recommendation",
    "execution_evidence",
    "claims",
    "extensions"
  ],
  "properties": {
    "protocol_id": {"const": "adco.specialist-exchange"},
    "contract_version": {"const": "1.0"},
    "message_type": {"const": "receipt"},
    "receipt_id": {"$ref": "#/$defs/safeToken"},
    "exchange_id": {"$ref": "#/$defs/safeToken"},
    "handoff_id": {"$ref": "#/$defs/safeToken"},
    "work_id": {"$ref": "#/$defs/safeToken"},
    "provider_id": {"$ref": "#/$defs/safeToken"},
    "profile_id": {"$ref": "#/$defs/safeToken"},
    "descriptor_sha256": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})?$"
    },
    "handoff_sha256": {"$ref": "#/$defs/sha256"},
    "outcome": {"enum": ["completed", "needs_user", "blocked", "failed"]},
    "consumed_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/consumedInput"}
    },
    "output_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/outputArtifact"}
    },
    "qa": {
      "type": "object",
      "required": ["status", "checks", "limitations"],
      "properties": {
        "status": {"enum": ["pass", "fail", "blocked", "needs_user"]},
        "checks": {"type": "array"},
        "limitations": {"type": "array"}
      },
      "additionalProperties": true
    },
    "open_questions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": {"$ref": "#/$defs/safeToken"},
          "question": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "specialist_recommendation": {"type": "string", "minLength": 1},
    "execution_evidence": {"$ref": "#/$defs/executionEvidence"},
    "claims": {
      "type": "object",
      "required": [
        "client_ready",
        "ppt_ready",
        "final_delivery_ready",
        "send_ready",
        "project_complete",
        "control_plane_updated"
      ],
      "properties": {
        "client_ready": {"const": false},
        "ppt_ready": {"const": false},
        "final_delivery_ready": {"const": false},
        "send_ready": {"const": false},
        "project_complete": {"const": false},
        "control_plane_updated": {"const": false}
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/extension"}
    },
    "simulated": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "completed"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "output_artifacts": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "needs_user"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "open_questions": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "safeToken": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "threadId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "consumedInput": {
      "type": "object",
      "required": ["artifact_id", "version", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/safeToken"},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "outputArtifact": {
      "type": "object",
      "required": [
        "provider_artifact_id",
        "kind",
        "version",
        "path",
        "sha256",
        "visibility",
        "source_input_ids"
      ],
      "properties": {
        "provider_artifact_id": {"$ref": "#/$defs/safeToken"},
        "kind": {"$ref": "#/$defs/safeToken"},
        "version": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "visibility": {"const": "internal_only"},
        "source_input_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safeToken"}
        }
      },
      "additionalProperties": true
    },
    "executionEvidence": {
      "type": "object",
      "required": ["mode", "thread_id", "nested_dispatch_used", "out_of_scope_writes"],
      "properties": {
        "mode": {"enum": ["inline", "codex_thread", "external_handoff"]},
        "thread_id": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/threadId"}
          ]
        },
        "nested_dispatch_used": {"const": false},
        "out_of_scope_writes": {
          "type": "array",
          "maxItems": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "codex_thread"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {"thread_id": {"$ref": "#/$defs/threadId"}}
          },
          "else": {
            "properties": {"thread_id": {"type": "null"}}
          }
        }
      ],
      "additionalProperties": true
    },
    "extension": {
      "type": "object",
      "required": ["id", "version", "payload"],
      "properties": {
        "id": {"$ref": "#/$defs/safeToken"},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "payload": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
