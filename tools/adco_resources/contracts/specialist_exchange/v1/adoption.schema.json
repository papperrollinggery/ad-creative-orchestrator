{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adco.specialist-exchange/adoption/1.0",
  "title": "ADCO specialist adoption decision v1",
  "type": "object",
  "required": [
    "protocol_id",
    "contract_version",
    "message_type",
    "adoption_id",
    "handoff_id",
    "receipt_id",
    "receipt_sha256",
    "decision_owner",
    "decision",
    "reason",
    "adopted_outputs",
    "rejected_outputs",
    "limitations_carried_forward",
    "adco_validation",
    "host_scope_proof",
    "gate_effect",
    "thread_reconciliation_ref",
    "created_at"
  ],
  "properties": {
    "protocol_id": {"const": "adco.specialist-exchange"},
    "contract_version": {"const": "1.0"},
    "message_type": {"const": "adoption"},
    "adoption_id": {"$ref": "#/$defs/safeToken"},
    "handoff_id": {"$ref": "#/$defs/safeToken"},
    "receipt_id": {"$ref": "#/$defs/safeToken"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "decision_owner": {"const": "adco"},
    "decision": {"enum": ["adopt", "partial_adopt", "reject", "defer"]},
    "reason": {"type": "string", "minLength": 1},
    "adopted_outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/adoptedOutput"}
    },
    "rejected_outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeToken"}
    },
    "limitations_carried_forward": {"type": "array"},
    "adco_validation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "host_scope_proof": {"$ref": "#/$defs/hostScopeProof"},
    "gate_effect": {
      "type": "object",
      "required": ["advance_allowed", "next_gate"],
      "properties": {
        "advance_allowed": {"type": "boolean"},
        "next_gate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "thread_reconciliation_ref": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/threadReconciliationRef"}
      ]
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "safeToken": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "threadId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "adoptedOutput": {
      "type": "object",
      "required": [
        "provider_artifact_id",
        "target_artifact_id",
        "target_path",
        "sha256",
        "visibility"
      ],
      "properties": {
        "provider_artifact_id": {"$ref": "#/$defs/safeToken"},
        "target_artifact_id": {"$ref": "#/$defs/safeToken"},
        "target_path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "visibility": {"const": "internal_only"}
      },
      "additionalProperties": false
    },
    "hostScopeProof": {
      "type": "object",
      "required": [
        "baseline_path",
        "baseline_sha256",
        "baseline_manifest_sha256",
        "observed_manifest_sha256",
        "changed_paths"
      ],
      "properties": {
        "baseline_path": {"$ref": "#/$defs/relativePath"},
        "baseline_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "observed_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "changed_paths": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "threadReconciliationRef": {
      "type": "object",
      "required": [
        "lane_id",
        "lane_run_id",
        "thread_id",
        "receipt_path",
        "receipt_sha256",
        "dispatch_receipt_path",
        "dispatch_receipt_sha256",
        "registry_sha256",
        "scope_proof_path",
        "scope_proof_sha256",
        "archived_at",
        "cleanup_action"
      ],
      "properties": {
        "lane_id": {"$ref": "#/$defs/safeToken"},
        "lane_run_id": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]{0,127}:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "thread_id": {"$ref": "#/$defs/threadId"},
        "receipt_path": {"$ref": "#/$defs/relativePath"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "dispatch_receipt_path": {"$ref": "#/$defs/relativePath"},
        "dispatch_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "scope_proof_path": {"$ref": "#/$defs/relativePath"},
        "scope_proof_sha256": {"$ref": "#/$defs/sha256"},
        "archived_at": {"type": "string", "format": "date-time"},
        "cleanup_action": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
