{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface",
    "decision",
    "external_action_taken",
    "required_controls",
    "work_that_can_continue",
    "reason"
  ],
  "properties": {
    "surface": {"type": "string", "const": "delivery"},
    "decision": {"type": "string", "const": "BLOCKED_BEFORE_SEND"},
    "external_action_taken": {"type": "boolean", "const": false},
    "required_controls": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 8}
    },
    "work_that_can_continue": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 12}
    },
    "reason": {"type": "string", "minLength": 60}
  }
}
