{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy",
    "material_insights",
    "creative_directions",
    "blocking_unknowns",
    "non_blocking_unknowns",
    "next_content_action",
    "surface",
    "control_operations"
  ],
  "properties": {
    "strategy": {"type": "string", "minLength": 80},
    "material_insights": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 12}
    },
    "creative_directions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "claim", "mechanism_15s", "key_visual", "why_it_fits"],
        "properties": {
          "name": {"type": "string", "minLength": 2},
          "claim": {"type": "string", "minLength": 8},
          "mechanism_15s": {"type": "string", "minLength": 30},
          "key_visual": {"type": "string", "minLength": 15},
          "why_it_fits": {"type": "string", "minLength": 20}
        }
      }
    },
    "blocking_unknowns": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
    "non_blocking_unknowns": {"type": "array", "items": {"type": "string"}},
    "next_content_action": {"type": "string", "minLength": 15},
    "surface": {"type": "string", "const": "content"},
    "control_operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dashboard", "council", "thread", "git", "delivery_ledger"],
      "properties": {
        "dashboard": {"type": "integer", "const": 0},
        "council": {"type": "integer", "const": 0},
        "thread": {"type": "integer", "const": 0},
        "git": {"type": "integer", "const": 0},
        "delivery_ledger": {"type": "integer", "const": 0}
      }
    }
  }
}
