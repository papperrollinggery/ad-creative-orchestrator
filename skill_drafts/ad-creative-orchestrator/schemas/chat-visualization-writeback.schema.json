{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/adco/chat-visualization-writeback.schema.json",
  "title": "ADCO Chat Visualization Controller Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source_spec",
    "intent",
    "controller_result",
    "authority",
    "artifact_results",
    "confirmation"
  ],
  "properties": {
    "contract": {"const": "adco.chat-visualization-writeback@1.0"},
    "source_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "view_id", "current_gate"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "view_id": {"type": "string", "minLength": 1},
        "current_gate": {"type": "string", "minLength": 1}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "selected_option_id", "human_readable_intent"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "selected_option_id": {"type": ["string", "null"]},
        "human_readable_intent": {"type": "string", "minLength": 1}
      }
    },
    "controller_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_gate", "validation_status", "recorded_change"],
      "properties": {
        "current_gate": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["PASS", "FAIL"]},
        "recorded_change": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_action_wrote_state", "controller_revalidated_source", "artifact_hashes_verified"],
      "properties": {
        "visual_action_wrote_state": {"const": false},
        "controller_revalidated_source": {"const": true},
        "artifact_hashes_verified": {"const": true}
      }
    },
    "artifact_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "path", "version", "sha256", "result"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "result": {"enum": ["created", "updated", "stale", "preserved"]}
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "artifact_status", "downstream_effect", "next_visible_stage"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "artifact_status": {"type": "string", "minLength": 1},
        "downstream_effect": {"type": "string", "minLength": 1},
        "next_visible_stage": {"type": "string", "minLength": 1}
      }
    }
  }
}
